<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="neo.jetbrains.shared"/>
    </dependencies>

    <resource-bundle>messages.NeoBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ai.neocode.client.migration.NeoMigrationService"/>
        <applicationService serviceImplementation="ai.neocode.client.autocomplete.NeoAutocompleteSettingsService"/>
        <customPasteProvider implementation="ai.neocode.client.session.ui.prompt.PromptAttachmentPasteProvider"/>

        <notificationGroup id="Neo Code"
                           displayType="BALLOON"
                           bundle="messages.NeoBundle"
                           key="notification.group.neo"/>

        <toolWindow id="Neo Code"
                    anchor="left"
                    icon="/icons/neo.svg"
                    factoryClass="ai.neocode.client.NeoToolWindowFactory"/>

        <fileEditorProvider id="NeoVfsEditor" implementation="ai.neocode.client.vfs.NeoFileEditorProvider"/>

        <applicationConfigurable
                parentId="tools"
                id="ai.neocode.jetbrains.settings"
                instance="ai.neocode.client.settings.NeoSettingsConfigurable"
                bundle="messages.NeoBundle"
                key="settings.neo.displayName"/>

        <applicationConfigurable
                parentId="ai.neocode.jetbrains.settings"
                id="ai.neocode.jetbrains.settings.profile"
                groupWeight="4"
                instance="ai.neocode.client.settings.profile.UserProfileConfigurable"
                bundle="messages.NeoBundle"
                key="settings.profile.displayName"/>

        <applicationConfigurable
                parentId="ai.neocode.jetbrains.settings"
                id="ai.neocode.jetbrains.settings.models"
                groupWeight="3"
                instance="ai.neocode.client.settings.models.ModelsConfigurable"
                bundle="messages.NeoBundle"
                key="settings.models.displayName"/>

        <applicationConfigurable
                parentId="ai.neocode.jetbrains.settings"
                id="ai.neocode.jetbrains.settings.providers"
                groupWeight="2"
                instance="ai.neocode.client.settings.providers.ProvidersConfigurable"
                bundle="messages.NeoBundle"
                key="settings.providers.displayName"/>

        <applicationConfigurable
                parentId="ai.neocode.jetbrains.settings"
                id="ai.neocode.jetbrains.settings.agentBehavior"
                groupWeight="1"
                instance="ai.neocode.client.settings.agents.AgentBehaviorConfigurable"
                bundle="messages.NeoBundle"
                key="settings.agentBehavior.displayName"/>

        <applicationConfigurable
                parentId="ai.neocode.jetbrains.settings.agentBehavior"
                id="ai.neocode.jetbrains.settings.agentBehavior.agents"
                instance="ai.neocode.client.settings.agents.AgentsConfigurable"
                bundle="messages.NeoBundle"
                key="settings.agentBehavior.agents.displayName"/>

        <applicationConfigurable
                parentId="ai.neocode.jetbrains.settings.agentBehavior"
                id="ai.neocode.jetbrains.settings.agentBehavior.mcp"
                instance="ai.neocode.client.settings.agents.McpConfigurable"
                bundle="messages.NeoBundle"
                key="settings.agentBehavior.mcp.displayName"/>

        <registryKey key="neo.session.condense"
                     description="Enable event condensing in the session update queue (merges redundant snapshots before model delivery)."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="neo.session.flushMs"
                     description="Session update queue flush cadence in milliseconds."
                     defaultValue="150"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="neo.session.inactive.disposeTimeoutMs"
                     description="Milliseconds before hidden session UI is disposed after switching away."
                     defaultValue="180000"
                     restartRequired="false"
                     overrides="false"/>
    </extensions>

    <applicationListeners>
        <listener class="ai.neocode.client.plugin.NeoFrontendDynamicPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action id="Neo.Restart"
                class="ai.neocode.client.actions.RestartNeoAction"/>

        <action id="Neo.Reinstall"
                class="ai.neocode.client.actions.ReinstallNeoAction"/>

        <action id="Neo.CoreInfo"
                class="ai.neocode.client.actions.CoreInfoAction"/>

        <action id="Neo.OpenSettings"
                class="ai.neocode.client.actions.OpenSettingsAction"/>

        <action id="Neo.OpenLocalConfig"
                class="ai.neocode.client.actions.OpenLocalConfigAction"/>

        <action id="Neo.OpenGlobalConfig"
                class="ai.neocode.client.actions.OpenGlobalConfigAction"/>

        <action id="Neo.ForceMigration"
                class="ai.neocode.client.actions.ForceMigrationAction"/>

        <group id="Neo.CliGroup" text="Core" popup="true">
            <reference ref="Neo.Restart"/>
            <reference ref="Neo.Reinstall"/>
            <separator/>
            <reference ref="Neo.CoreInfo"/>
        </group>

        <group id="Neo.OpenConfigGroup" text="Config Files" popup="true">
            <reference ref="Neo.OpenLocalConfig"/>
            <reference ref="Neo.OpenGlobalConfig"/>
            <separator/>
            <reference ref="Neo.ForceMigration"/>
        </group>

        <group id="Neo.SettingsGroup">
            <reference ref="Neo.OpenSettings"/>
            <separator/>
            <reference ref="Neo.OpenConfigGroup"/>
            <separator/>
            <reference ref="Neo.CliGroup"/>
        </group>

        <action id="Neo.Settings"
                class="ai.neocode.client.actions.NeoSettingsAction"
                icon="AllIcons.General.GearPlain"/>

        <action id="Neo.NewSession"
                class="ai.neocode.client.actions.NewSessionAction"/>

        <action id="Neo.History"
                class="ai.neocode.client.actions.HistoryAction"/>

        <!-- Declarative toolbar group for the Neo tool window title bar -->
        <group id="Neo.ToolWindowToolbar">
            <reference ref="Neo.NewSession"/>
            <reference ref="Neo.History"/>
            <reference ref="Neo.Settings"/>
        </group>

        <action id="Neo.SendPrompt"
                class="ai.neocode.client.actions.SendPromptAction"
                text="Send Prompt"
                description="Send the current Neo prompt">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="meta ENTER"/>
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control ENTER"/>
        </action>

        <action id="Neo.StopSession"
                class="ai.neocode.client.actions.StopSessionAction"
                text="Stop Session"
                description="Stop the current Neo session">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="alt S"/>
        </action>

        <action id="Neo.Session.Open"
                class="ai.neocode.client.actions.OpenSessionAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ENTER"/>
        </action>

        <action id="Neo.Session.Rename"
                class="ai.neocode.client.actions.RenameSessionAction"
                use-shortcut-of="RenameElement"/>

        <action id="Neo.Session.Delete"
                class="ai.neocode.client.actions.DeleteSessionAction"
                use-shortcut-of="$Delete"/>

        <group id="Neo.History.ContextMenu">
            <reference ref="Neo.Session.Open"/>
            <separator/>
            <reference ref="Neo.Session.Rename"/>
            <reference ref="Neo.Session.Delete"/>
        </group>

        <group id="Neo.Session.ContextMenu">
            <reference ref="$Copy"/>
        </group>
    </actions>
</idea-plugin>
