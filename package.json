{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "neocode",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun run --cwd packages/neocode --conditions=browser src/index.ts",
    "dev:desktop": "bun --cwd packages/desktop tauri dev",
    "dev:web": "bun --cwd packages/app dev",
    "typecheck": "bun turbo typecheck",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "hello": "echo 'Hello World!'",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/console/*",
      "packages/sdk/js",
      "packages/slack"
    ],
    "catalog": {
      "@types/bun": "1.3.9",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "ulid": "3.0.1",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "22.13.9",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.1.0-beta.13",
      "@solid-primitives/storage": "4.3.3",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "dompurify": "3.3.1",
      "drizzle-kit": "1.0.0-beta.12-a5629fb",
      "drizzle-orm": "1.0.0-beta.12-a5629fb",
      "ai": "5.0.124",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "@playwright/test": "1.51.0",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "virtua": "0.42.3",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@solidjs/start": "https://pkg.pr.new/@solidjs/start@dfb2020",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10"
    }
  },
  "devDependencies": {
    "@actions/artifact": "6.1.0",
    "@tsconfig/bun": "1.0.10",
    "@types/mime-types": "3.0.1",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "semver": "7.7.4",
    "turbo": "2.8.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.995.0",
    "@neocode-ai/plugin": "workspace:*",
    "@neocode-ai/script": "workspace:*",
    "@neocode-ai/sdk": "workspace:*",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neopilot-ai/neocode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "fast-xml-parser": "^5.3.7",
    "hono": "^4.11.4",
    "seroval": "^1.4.2",
    "@isaacs/brace-expansion": "^5.0.1",
    "minimatch": "^10.2.1",
    "wrangler": "^4.59.1",
    "axios": "^1.13.5",
    "tar": "^7.5.9",
    "astro": "^5.13.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@astrojs/cloudflare": "^12.6.6",
    "react-router": "^6.30.2",
    "@remix-run/router": "^1.23.2",
    "qs": "^6.14.2",
    "ajv": "^8.18.0",
    "vite": "^7.1.10",
    "undici": "^6.23.0",
    "diff": "^8.0.3",
    "devalue": "^5.6.3",
    "esbuild": "^0.25.0"
  },
  "patchedDependencies": {
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "@openrouter/ai-sdk-provider@1.5.4": "patches/@openrouter%2Fai-sdk-provider@1.5.4.patch"
  }
}
